rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User profile
    match /users/{userId} {

      // Only the owner can read their own profile
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // User can create their own profile
      allow create: if request.auth != null
        && request.auth.uid == userId;

      // User can update their own profile
      allow update: if request.auth != null
        && request.auth.uid == userId;

      // User profiles cannot be deleted
      allow delete: if false;


      // User's bills
      match /bills/{billId} {

        // Only the logged-in user can access their own bills
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }


      // User's settings (e.g. settings/meters)
      match /settings/{settingId} {

        // Only the logged-in user can access their own settings
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }
    }
  }
}
