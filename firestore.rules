rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidProfile(data) {
      return data.keys().hasOnly(["preferredName"])
        && (!("preferredName" in data)
          || (data.preferredName is string
            && data.preferredName.size() > 0
            && data.preferredName.size() <= 30));
    }

    // User profile
    match /users/{userId} {

      // Only the owner can read their own profile
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // User can create their own profile
      allow create: if request.auth != null
        && request.auth.uid == userId;

      // User can update their own profile
      allow update: if request.auth != null
        && request.auth.uid == userId;

      // User profiles cannot be deleted
      allow delete: if false;


      // User's bills
      match /bills/{billId} {

        // Only the logged-in user can access their own bills
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }


      // User's income (salary and other earnings)
      match /income/{incomeId} {

        // Only the logged-in user can access their own income
        allow read, write: if request.auth != null
          && request.auth.uid == userId;
      }


      // User's settings (e.g. settings/meters)
      match /settings/{settingId} {

        // Only the logged-in user can access their own settings
        allow read, delete: if request.auth != null
          && request.auth.uid == userId;

        // The profile only holds a short preferred name
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && (settingId != "profile" || isValidProfile(request.resource.data));
      }
    }
  }
}
